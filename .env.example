# OMEN environment. Copy to ~/.config/omen/omen.env (scripts/install-pi.sh does this), chmod 600.
# NEVER commit the real file, paste tokens into chat, or post them in Discord.

# ---------------------------------------------------------------- Discord (same server as STONKS / APEX)
# Option A (simplest): one webhook per channel. Discord: channel -> Edit Channel -> Integrations -> Webhooks.
# Keys: plays (#kalshi-plays), research (#kalshi-research, optional), status (#kalshi-status), default (fallback).
OMEN_DISCORD_WEBHOOKS={"plays":"https://discord.com/api/webhooks/REPLACE/REPLACE","status":"https://discord.com/api/webhooks/REPLACE/REPLACE"}
# A single webhook for everything also works:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/REPLACE

# Option B: reuse the STONKS/APEX bot token (REST only; OMEN never opens a Gateway connection, so it does not
# conflict with the running APEX bot). The bot needs View Channel + Send Messages + Embed Links in these channels.
# DISCORD_BOT_TOKEN=REPLACE_WITH_THE_SAME_TOKEN_AS_APEX
# OMEN_DISCORD_CHANNEL_MAP={"plays":"123456789012345678","research":"123456789012345679","status":"123456789012345680"}

# ---------------------------------------------------------------- Health (optional, free)
# A dead-man's switch such as https://healthchecks.io (free tier): pinged after every successful cycle,
# /fail on errors. You get an email/Discord alert if OMEN stops.
# OMEN_HEALTHCHECK_URL=https://hc-ping.com/REPLACE-UUID

# ---------------------------------------------------------------- Website (optional, docs/WEB.md)
# The Pi pushes its live plays, activity and paper ledger to your OMEN website. Use the SAME secret as in Vercel.
# OMEN_WEB_URL=https://your-project.vercel.app
# OMEN_INGEST_SECRET=REPLACE_WITH_openssl_rand_hex_32
# OMEN_PUBLISH_SECONDS=120          # heartbeat; it also publishes whenever the plays change
# OMEN_VERCEL_BYPASS=               # only if Vercel Deployment Protection covers the production URL

# ---------------------------------------------------------------- Runtime
# OMEN_STATE_DIR=~/.omen            # ledger, lock file, KILL switch
# OMEN_CONFIG=/path/to/omen.toml    # default: <repo>/config/omen.toml
# OMEN_LOG_LEVEL=INFO

# ---------------------------------------------------------------- Execution (OFF unless you opt in)
# Scanning needs no Kalshi account. Order placement needs an API key (Kalshi -> Account -> API keys).
# OMEN_EXECUTION_MODE=off           # off | demo | live
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=~/.config/omen/kalshi-private-key.pem   # chmod 600
# OMEN_LIVE_ACK="I accept real-money risk"   # required for live mode
# OMEN_LP_MODE=paper                # liquidity-reward quoting (omen lp run): paper | live
